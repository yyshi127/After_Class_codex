{
  "name": "afterclass",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @afterclass/web --filter @afterclass/api dev",
    "dev:web": "pnpm --filter @afterclass/web dev",
    "dev:api": "pnpm --filter @afterclass/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:api": "powershell -ExecutionPolicy Bypass -File scripts/smoke-api.ps1",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @afterclass/db prisma:generate",
    "db:migrate": "pnpm --filter @afterclass/db prisma:migrate",
    "db:seed": "pnpm --filter @afterclass/db seed",
    "db:studio": "pnpm --filter @afterclass/db prisma:studio",
    "docker:dev": "docker compose up -d postgres redis minio"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
