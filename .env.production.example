NODE_ENV=production
APP_DOMAIN=your-domain.example.com
APP_BASE_URL=https://your-domain.example.com
API_BASE_URL=https://your-domain.example.com/api
NEXT_PUBLIC_API_BASE_URL=/api

POSTGRES_DB=afterclass
POSTGRES_USER=afterclass
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql://afterclass:change_this_postgres_password@postgres:5432/afterclass

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=afterclass_minio
MINIO_ROOT_PASSWORD=change_this_minio_password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=afterclass
S3_ACCESS_KEY=afterclass_minio
S3_SECRET_KEY=change_this_minio_password
S3_REGION=local

JWT_SECRET=change_this_jwt_secret
ENCRYPTION_KEY=change_this_32_byte_encryption_key

AI_PROVIDER=placeholder
AI_API_KEY=change_this_ai_api_key

BACKUP_RETENTION_DAYS=7
